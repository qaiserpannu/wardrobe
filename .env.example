# Copy to .env.local and fill in. Never commit real values.

# Database (local development default matches docker-compose.yml)
DATABASE_URL=postgres://wardrobe:wardrobe@localhost:5432/wardrobe

# Public address of the site, used in social previews and WhatsApp messages.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image storage. "local" keeps files in ./storage (development only).
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./storage

# Optional: WhatsApp number put into the sample data by "npm run db:seed"
# (digits only, international format). Leave unset until a real number is chosen.
# SEED_WHATSAPP_NUMBER=

# Milestone 4 - AI assistant (server-side only)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Milestone 5 - admin auth
# AUTH_SECRET=
