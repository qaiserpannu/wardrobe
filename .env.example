# Copy to .env.local and fill in. Never commit real values.

# Database (local development default matches docker-compose.yml)
DATABASE_URL=postgres://wardrobe:wardrobe@localhost:5432/wardrobe

# Public address of the site, used in social previews and WhatsApp messages.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image storage. "local" keeps files in ./storage (development only).
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./storage

# Optional: WhatsApp number put into the sample data by "npm run db:seed"
# (digits only, international format). Leave unset until a real number is chosen.
# SEED_WHATSAPP_NUMBER=

# AI assistant in the chat (server-side only, never sent to the browser).
# Without a key the chat button simply opens WhatsApp, as before.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Optional: which Claude model answers, and how hard it thinks (low | medium | high).
# AI_MODEL=claude-haiku-5-5
# AI_EFFORT=low

# Optional: email the owner's notifications through Resend (resend.com).
# The address they go to is the "notifyEmail" assistant setting.
# RESEND_API_KEY=
# NOTIFY_EMAIL_FROM=Pre-Loved Wardrobe <alerts@your-domain.com>

# The admin account is not configured here. Create it with: npm run admin:create
